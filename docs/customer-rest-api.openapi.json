{
  "openapi": "3.0.3",
  "info": {
    "title": "Kirk Customer REST API",
    "version": "1.0.0",
    "description": "Customer route for model discovery. Separate from the hosted MCP service. Supply a customer key through local secret controls."
  },
  "servers": [
    {
      "url": "https://api.kavara.ai"
    }
  ],
  "security": [
    {
      "KavaraKey": []
    }
  ],
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "Read available models",
        "responses": {
          "200": {
            "description": "Model list. release_id is the release identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "result": {
                      "type": "object",
                      "required": [
                        "models",
                        "release_id"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "models": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "kind",
                              "description"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "tool": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "release_id": {
                          "type": "string",
                          "description": "The release identifier."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "result": {
                    "models": [
                      {
                        "id": "example-model",
                        "kind": "example-kind",
                        "description": "Example description.",
                        "tool": "example-tool"
                      }
                    ],
                    "release_id": "example-release"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Adapter error; infrastructure-generated errors can use a different envelope. See customer-rest-api.md for status/code mapping.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "No query strings. Do not send Idempotency-Key on GET requests."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "KavaraKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kavara-Key",
        "description": "Exactly one customer key header: k_ followed by 32 lowercase hex characters."
      }
    }
  }
}
